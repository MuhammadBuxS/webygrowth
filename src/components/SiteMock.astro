---
interface Props { brand: string; headline: string; cta: string; hue: number; url?: string; class?: string; compact?: boolean }
const { brand, headline, cta, hue, url, class: cls, compact = false } = Astro.props;
const domain = url ?? brand.toLowerCase().replace(/[^a-z]+/g, '') + '.co.uk';
---
<div class:list={['browser mock', cls, { 'mock--compact': compact }]} style={`--h:${hue}`} aria-hidden="true">
  <div class="browser__bar">
    <div class="browser__dots"><i></i><i></i><i></i></div>
    <div class="browser__url">
      <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="5" y="10.5" width="14" height="10" rx="2"/><path d="M8 10.5V7.5a4 4 0 0 1 8 0v3"/></svg>
      {domain}
    </div>
  </div>
  <div class="mock__body">
    <div class="mock__nav">
      <span class="mock__brand"><i></i>{brand}</span>
      <span class="mock__links"><b></b><b></b><b></b></span>
      <span class="mock__btn mock__btn--sm">{cta}</span>
    </div>
    <div class="mock__hero">
      <div class="mock__copy">
        <span class="mock__stars">★★★★★ <em>Rated excellent</em></span>
        <strong>{headline}</strong>
        <span class="mock__line"></span><span class="mock__line short"></span>
        <span class="mock__btn">{cta} →</span>
      </div>
      <div class="mock__img"><span></span></div>
    </div>
    {!compact && (
      <div class="mock__cards">
        <span></span><span></span><span></span>
      </div>
    )}
  </div>
</div>

<style>
  .mock { --c: hsl(var(--h) 75% 48%); --c-soft: hsl(var(--h) 80% 95%); font-family: var(--font-body); }
  .mock__body { padding: 16px 20px 22px; background: linear-gradient(180deg, var(--c-soft), #fff 70%); }
  .mock__nav { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 26px; }
  .mock__brand { display: flex; align-items: center; gap: 7px; font-weight: 700; font-size: 12px; letter-spacing: -.02em; color: #111; white-space: nowrap; }
  .mock__brand i { width: 16px; height: 16px; border-radius: 5px; background: var(--c); }
  .mock__links { display: flex; gap: 10px; }
  .mock__links b { width: 30px; height: 5px; border-radius: 3px; background: #d9dbe2; }
  .mock__btn { display: inline-block; background: var(--c); color: #fff; font-size: 11px; font-weight: 600; padding: 8px 13px; border-radius: 999px; white-space: nowrap; box-shadow: 0 6px 14px -6px var(--c); }
  .mock__btn--sm { padding: 6px 10px; font-size: 10px; }
  .mock__hero { display: grid; grid-template-columns: 1.1fr 1fr; gap: 18px; align-items: center; }
  .mock__copy { display: grid; gap: 9px; justify-items: start; }
  .mock__stars { font-size: 10px; color: #f5a623; letter-spacing: 1px; }
  .mock__stars em { color: #777; font-style: normal; letter-spacing: 0; margin-left: 4px; }
  .mock__copy strong { font-family: var(--font-display); font-size: clamp(16px, 2vw, 23px); line-height: 1.02; letter-spacing: -.04em; color: #0b0c12; }
  .mock__line { height: 6px; width: 100%; border-radius: 3px; background: #e2e4ea; }
  .mock__line.short { width: 70%; margin-bottom: 4px; }
  .mock__img { aspect-ratio: 1 / 1; border-radius: 14px; position: relative; overflow: hidden;
    background: radial-gradient(circle at 30% 25%, hsl(var(--h) 90% 75%), transparent 55%), linear-gradient(140deg, hsl(var(--h) 70% 55%), hsl(calc(var(--h) + 40) 70% 30%)); }
  .mock__img span { position: absolute; inset: auto 12px 12px 12px; height: 34px; border-radius: 10px; background: rgba(255,255,255,.85); }
  .mock__img span::before { content: ''; position: absolute; left: 10px; top: 10px; width: 14px; height: 14px; border-radius: 50%; background: var(--c); }
  .mock__img span::after { content: ''; position: absolute; left: 32px; right: 20px; top: 14px; height: 5px; border-radius: 3px; background: #cfd2da; }
  .mock__cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-top: 20px; }
  .mock__cards span { height: 54px; border-radius: 10px; background: #fff; border: 1px solid #eceef3; position: relative; }
  .mock__cards span::before { content: ''; position: absolute; left: 10px; top: 10px; width: 16px; height: 16px; border-radius: 5px; background: var(--c-soft); box-shadow: inset 0 0 0 1px var(--c); }
  .mock__cards span::after { content: ''; position: absolute; left: 10px; right: 14px; bottom: 11px; height: 5px; border-radius: 3px; background: #e3e5eb; }
  .mock--compact .mock__nav { margin-bottom: 16px; }
  .mock--compact .mock__links { display: none; }
</style>
