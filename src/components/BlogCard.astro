---
import Icon from './Icon.astro';
import { formatDate, readingTime, type Post } from '../lib/posts';

interface Props { post: Post; featured?: boolean; class?: string; style?: string }
const { post, featured = false, class: cls, style } = Astro.props;
const { title, description, category, pubDate } = post.data;
---
<a href={`/blog/${post.id}/`} style={style} class:list={['pcard', cls, { 'pcard--featured': featured }]}>
  <div class="pcard__top">
    <span class="pcard__cat">{category}</span>
    <span class="pcard__time">{readingTime(post.body ?? '')} min read</span>
  </div>
  <h3>{title}</h3>
  <p class="muted">{description}</p>
  <div class="pcard__foot">
    <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
    <span class="pcard__go">Read <Icon name="arrow" size={15} /></span>
  </div>
</a>

<style>
  .pcard { display: flex; flex-direction: column; gap: 14px; padding: clamp(22px, 2.6vw, 30px); border-radius: var(--radius); background: #fff; border: 1px solid var(--line); transition: transform .5s var(--ease), box-shadow .5s var(--ease), border-color .3s, opacity 1s var(--ease); }
  .pcard.in:hover, .pcard:not(.reveal):hover { transform: translateY(-5px); box-shadow: 0 30px 60px -30px rgba(10,20,60,.25); border-color: rgba(37,99,235,.35); }
  .pcard__top { display: flex; align-items: center; gap: 12px; }
  .pcard__cat { font-size: .74rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--blue); background: #eef3ff; padding: 5px 11px; border-radius: 999px; }
  .pcard__time { font-size: .82rem; color: var(--muted); }
  .pcard h3 { font-size: clamp(1.25rem, 1.7vw, 1.5rem); letter-spacing: -.03em; }
  .pcard p { font-size: .95rem; flex: 1; }
  .pcard__foot { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding-top: 14px; border-top: 1px solid var(--line); font-size: .86rem; color: var(--muted); }
  .pcard__go { display: inline-flex; align-items: center; gap: 7px; font-weight: 600; color: var(--blue); }
  .pcard:hover .pcard__go :global(svg) { transform: translateX(4px); }
  .pcard__go :global(svg) { transition: transform .3s; }
  .pcard--featured { background: linear-gradient(150deg, #fff 45%, #eef3ff); }
  .pcard--featured h3 { font-size: clamp(1.6rem, 2.6vw, 2.3rem); }
  .pcard--featured p { font-size: 1.05rem; }
</style>
