---
import Icon from './Icon.astro';
import { PROCESS, waLink } from '../data/site';
---
<section class="section process" aria-labelledby="process-title">
  <div class="container process__grid">
    <div class="process__head">
      <p class="eyebrow reveal">How we work</p>
      <h2 id="process-title" class="display-lg reveal" style="--d:.05s">A clear process from <span class="serif-i">strategy</span> to launch.</h2>
      <p class="lead reveal" style="--d:.1s">No jargon, no guesswork. You always know what is happening, what comes next, and why it matters for your business.</p>
      <a class="btn btn-wa reveal" style="--d:.15s" href={waLink("Hi WebyGrowth, I'd like to book a free consultation.")} target="_blank" rel="noopener"><Icon name="whatsapp" size={20} /> Book a free consultation</a>
    </div>
    <ol class="process__steps">
      {PROCESS.map((step, i) => (
        <li class="process__step reveal" style={`--d:${i * 0.06}s`}>
          <span class="process__num">0{i + 1}</span>
          <div>
            <h3>{step.title}</h3>
            <p class="muted">{step.text}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
<style>
  .process { background: var(--paper); }
  .process__grid { display: grid; grid-template-columns: 1fr 1.1fr; gap: clamp(40px, 7vw, 110px); align-items: start; }
  .process__head { position: sticky; top: 130px; display: grid; gap: 24px; justify-items: start; }
  .process__steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; }
  .process__step { display: grid; grid-template-columns: auto 1fr; gap: 28px; padding: 34px; background: #fff; border: 1px solid var(--line); border-radius: var(--radius); transition: transform .5s var(--ease), box-shadow .5s var(--ease), opacity 1s var(--ease); }
  .process__step.in:hover { transform: translateX(6px); box-shadow: -6px 0 0 var(--blue), 0 30px 60px -30px rgba(10,20,60,.2); }
  .process__num { font-family: var(--font-display); font-weight: 800; font-size: 3.2rem; line-height: .9; letter-spacing: -.05em; background: var(--grad); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .process__step h3 { font-size: 1.5rem; letter-spacing: -.03em; margin-bottom: 10px; }
  @media (max-width: 900px) { .process__grid { grid-template-columns: 1fr; } .process__head { position: static; } }
  @media (max-width: 520px) { .process__step { grid-template-columns: 1fr; gap: 12px; padding: 26px; } }
</style>
