---
import Icon from './Icon.astro';
import { waLink } from '../data/site';
---
<div class="wa" data-wa>
  <div class="wa__bubble" data-wa-bubble hidden>
    <button class="wa__close" type="button" aria-label="Dismiss" data-wa-close><Icon name="x" size={14} stroke={2.4} /></button>
    <p><strong>Need a website that brings in leads?</strong></p>
    <p>Chat with us on WhatsApp for a free quote.</p>
    <a href={waLink()} target="_blank" rel="noopener" class="wa__bubble-link">Start chat →</a>
  </div>
  <a class="wa__btn" href={waLink()} target="_blank" rel="noopener" aria-label="Chat with WebyGrowth on WhatsApp">
    <Icon name="whatsapp" size={30} />
    <span class="wa__label">Chat on WhatsApp</span>
  </a>
</div>

<script>
  const bubble = document.querySelector<HTMLElement>('[data-wa-bubble]');
  const close = document.querySelector<HTMLButtonElement>('[data-wa-close]');
  let dismissed = false;
  try { dismissed = sessionStorage.getItem('wa-bubble') === 'off'; } catch {}
  if (bubble && !dismissed) {
    setTimeout(() => { bubble.hidden = false; }, 6000);
  }
  close?.addEventListener('click', () => {
    if (bubble) bubble.hidden = true;
    try { sessionStorage.setItem('wa-bubble', 'off'); } catch {}
  });
</script>

<style>
  .wa { position: fixed; right: clamp(14px, 2.5vw, 28px); bottom: clamp(14px, 2.5vw, 28px); z-index: 60; display: grid; justify-items: end; gap: 12px; }
  .wa__btn {
    position: relative; display: flex; align-items: center; gap: 10px; height: 62px; padding: 0 16px;
    border-radius: 999px; background: #25d366; color: #fff;
    box-shadow: 0 14px 34px -8px rgba(37, 211, 102, .6), 0 4px 12px rgba(0,0,0,.18);
    transition: transform .4s var(--ease), box-shadow .4s var(--ease);
  }
  .wa__btn::before { content: ''; position: absolute; inset: 0; border-radius: inherit; background: #25d366; z-index: -1; animation: wa-ping 2.4s var(--ease) infinite; }
  .wa__btn:hover { transform: translateY(-3px) scale(1.03); box-shadow: 0 20px 44px -10px rgba(37, 211, 102, .75), 0 4px 12px rgba(0,0,0,.2); }
  .wa__label { font-weight: 700; font-size: .98rem; color: #fff; white-space: nowrap; padding-right: 4px; }
  @keyframes wa-ping { 0% { transform: scale(1); opacity: .55; } 80%, 100% { transform: scale(1.35); opacity: 0; } }

  .wa__bubble {
    position: relative; width: min(280px, calc(100vw - 32px)); padding: 16px 18px; border-radius: 18px 18px 4px 18px;
    background: #fff; color: var(--text); font-size: .9rem; line-height: 1.45;
    box-shadow: 0 24px 50px -16px rgba(0,0,0,.35), 0 0 0 1px rgba(0,0,0,.05);
    animation: wa-pop .5s var(--ease);
  }
  .wa__bubble[hidden] { display: none; }
  .wa__bubble p + p { color: var(--muted); margin-top: 2px; }
  .wa__bubble-link { display: inline-block; margin-top: 10px; font-weight: 700; color: #128c4a; }
  .wa__close { position: absolute; top: 8px; right: 8px; width: 26px; height: 26px; border: 0; border-radius: 50%; background: #f1f2f5; color: var(--muted); display: grid; place-items: center; }
  @keyframes wa-pop { from { opacity: 0; transform: translateY(10px) scale(.96); } }

  @media (max-width: 640px) {
    .wa__btn { width: 60px; height: 60px; padding: 0; justify-content: center; }
    .wa__label { display: none; }
  }
</style>
