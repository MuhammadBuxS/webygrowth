---
import { TESTIMONIALS } from '../data/site';
import Icon from './Icon.astro';
---
<section class="section dark testi noise" aria-labelledby="testi-title">
  <div class="glow" style="width:600px;height:600px;background:#7c3aed;right:-200px;top:0;opacity:.22"></div>
  <div class="container">
    <div class="sec-head split">
      <div>
        <p class="eyebrow reveal">Client words</p>
        <h2 id="testi-title" class="display-lg reveal" style="--d:.05s">Business owners feel <span class="grad-text">the difference.</span></h2>
      </div>
      <p class="lead reveal" style="--d:.1s">From tradesmen to ecommerce brands — here is what clients say after launch.</p>
    </div>
    <div class="testi__grid">
      {TESTIMONIALS.map((t, i) => (
        <figure class="testi__card reveal" style={`--d:${i * 0.08}s`}>
          <div class="testi__stars" role="img" aria-label="5 out of 5 stars">
            {[0, 1, 2, 3, 4].map(() => <Icon name="star" size={16} stroke={0} />)}
          </div>
          <blockquote>“{t.quote}”</blockquote>
          <figcaption>
            <span class="testi__avatar">{t.role.slice(0, 2).toUpperCase()}</span>
            <span><strong>{t.name}</strong><small>{t.role}</small></span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
<style>
  .testi { overflow: hidden; }
  .testi__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; position: relative; align-items: start; }
  .testi__card { margin: 0; padding: 34px; border-radius: var(--radius); background: linear-gradient(180deg, rgba(255,255,255,.06), rgba(255,255,255,.02)); border: 1px solid var(--line-dark); display: flex; flex-direction: column; gap: 24px; transition: transform 1s var(--ease), opacity 1s var(--ease), border-color .3s; }
  .testi__card:hover { border-color: rgba(124,196,255,.35); }
  @media (min-width: 901px) { .testi__card.in:nth-child(2) { transform: translateY(40px); } }
  .testi__stars { display: flex; gap: 3px; color: #fbbf24; }
  blockquote { margin: 0; font-family: var(--font-display); font-size: 1.35rem; line-height: 1.3; letter-spacing: -.02em; font-weight: 500; flex: 1; }
  figcaption { display: flex; gap: 14px; align-items: center; padding-top: 22px; border-top: 1px solid var(--line-dark); }
  figcaption strong { display: block; font-size: .95rem; }
  figcaption small { color: var(--muted-dark); }
  .testi__avatar { width: 44px; height: 44px; flex-shrink: 0; border-radius: 50%; display: grid; place-items: center; font-weight: 700; font-size: .8rem; background: var(--grad); color: #fff; }
  @media (max-width: 900px) { .testi__grid { grid-template-columns: 1fr; } }
</style>
