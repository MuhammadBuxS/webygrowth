---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { NAV_SERVICES, NAV_INDUSTRIES } from '../data/site';
import { PAGES } from '../data/pages';

const path = Astro.url.pathname;
const iconFor = (href: string) => PAGES.find((p) => `/${p.slug}/` === href)?.icon ?? 'layers';
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const servicesActive = [...NAV_SERVICES, ...NAV_INDUSTRIES].some((i) => path.startsWith(i.href)) || path.startsWith('/services/');
---
<header class="hdr" data-hdr>
  <div class="hdr__inner">
    <Logo class="on-dark" />

    <nav class="hdr__nav" aria-label="Main">
      <a href="/" aria-current={isActive('/') ? 'page' : undefined}>Home</a>
      <div class="has-menu">
        <a href="/services/" aria-current={servicesActive ? 'page' : undefined} aria-haspopup="true">
          Services <Icon name="chevron" size={14} stroke={2.2} />
        </a>
        <div class="mega" role="menu">
          <div class="mega__col">
            <p class="mega__title">What we build</p>
            {NAV_SERVICES.map((s) => (
              <a class="mega__item" href={s.href} role="menuitem">
                <span class="mega__icon"><Icon name={iconFor(s.href)} size={18} /></span>
                <span><strong>{s.label}</strong><small>{s.desc}</small></span>
              </a>
            ))}
          </div>
          <div class="mega__col mega__col--alt">
            <p class="mega__title">Industries</p>
            {NAV_INDUSTRIES.map((s) => (
              <a class="mega__link" href={s.href} role="menuitem">
                <Icon name={iconFor(s.href)} size={16} /> {s.label}
              </a>
            ))}
            <a class="mega__promo" href="/contact/">
              <span class="mega__promo-tag">Free</span>
              <strong>Website audit</strong>
              <small>See exactly what's costing you leads.</small>
              <Icon name="arrow-up-right" size={18} class="mega__promo-arrow" />
            </a>
          </div>
        </div>
      </div>
      <a href="/about/" aria-current={isActive('/about/') ? 'page' : undefined}>About</a>
      <a href="/contact/" aria-current={isActive('/contact/') ? 'page' : undefined}>Contact</a>
    </nav>

    <div class="hdr__cta">
      <a class="btn btn-primary btn-sm" href="/contact/">Free website audit</a>
      <button class="hdr__burger" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu" data-burger>
        <span></span><span></span>
      </button>
    </div>
  </div>

  <div class="mob" id="mobile-menu" data-mob hidden>
    <nav aria-label="Mobile">
      <a href="/">Home</a>
      <a href="/services/">Services</a>
      <a href="/about/">About</a>
      <a href="/contact/">Contact</a>
    </nav>
    <div class="mob__grid">
      <div>
        <p class="mega__title">Services</p>
        {NAV_SERVICES.map((s) => <a href={s.href}>{s.label}</a>)}
      </div>
      <div>
        <p class="mega__title">Industries</p>
        {NAV_INDUSTRIES.map((s) => <a href={s.href}>{s.label}</a>)}
      </div>
    </div>
    <a class="btn btn-primary" href="/contact/">Get a free website audit</a>
  </div>
</header>

<script>
  const hdr = document.querySelector<HTMLElement>('[data-hdr]')!;
  const burger = document.querySelector<HTMLButtonElement>('[data-burger]')!;
  const mob = document.querySelector<HTMLElement>('[data-mob]')!;
  const onScroll = () => hdr.classList.toggle('is-scrolled', window.scrollY > 20);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
  burger.addEventListener('click', () => {
    const open = burger.getAttribute('aria-expanded') === 'true';
    burger.setAttribute('aria-expanded', String(!open));
    burger.setAttribute('aria-label', open ? 'Open menu' : 'Close menu');
    mob.hidden = open;
    hdr.classList.toggle('is-open', !open);
    document.body.style.overflow = open ? '' : 'hidden';
  });
</script>

<style>
  .hdr { position: fixed; inset: 0 0 auto; z-index: 50; padding: 14px var(--gutter); transition: padding .4s var(--ease); }
  .hdr__inner {
    max-width: calc(var(--container) - 2 * var(--gutter) + 40px); margin-inline: auto;
    display: flex; align-items: center; justify-content: space-between; gap: 20px;
    padding: 10px 10px 10px 20px; border-radius: 999px; color: #fff;
    border: 1px solid transparent; transition: background .4s, border-color .4s, backdrop-filter .4s, box-shadow .4s;
  }
  .hdr.is-scrolled .hdr__inner, .hdr.is-open .hdr__inner {
    background: rgba(8, 9, 15, 0.72); border-color: rgba(255,255,255,0.09);
    backdrop-filter: blur(18px) saturate(160%); -webkit-backdrop-filter: blur(18px) saturate(160%);
    box-shadow: 0 20px 40px -20px rgba(0,0,0,.5);
  }
  .hdr__nav { display: flex; align-items: center; gap: 4px; }
  .hdr__nav > a, .has-menu > a {
    display: inline-flex; align-items: center; gap: 4px; padding: 10px 16px; border-radius: 999px;
    font-size: .95rem; font-weight: 500; color: #c9cddb; transition: color .2s, background .2s;
  }
  .hdr__nav > a:hover, .has-menu > a:hover, .hdr__nav a[aria-current='page'] { color: #fff; background: rgba(255,255,255,0.07); }
  .has-menu { position: relative; }
  .has-menu > a :global(svg) { transition: transform .3s; }
  .has-menu:hover > a :global(svg), .has-menu:focus-within > a :global(svg) { transform: rotate(180deg); }

  .mega {
    position: absolute; top: calc(100% + 14px); left: 50%; width: 700px;
    display: grid; grid-template-columns: 1.25fr 1fr; gap: 8px; padding: 10px;
    background: rgba(12, 14, 22, 0.96); border: 1px solid rgba(255,255,255,.1); border-radius: 24px;
    box-shadow: 0 40px 80px -20px rgba(0,0,0,.6); backdrop-filter: blur(20px);
    opacity: 0; visibility: hidden; transform: translate(-50%, 8px); transition: all .35s var(--ease);
  }
  .mega::before { content: ''; position: absolute; inset: -16px 0 auto; height: 16px; }
  .has-menu:hover .mega, .has-menu:focus-within .mega { opacity: 1; visibility: visible; transform: translate(-50%, 0); }
  .mega__col { padding: 12px; display: grid; gap: 2px; align-content: start; }
  .mega__col--alt { background: rgba(255,255,255,.03); border-radius: 16px; }
  .mega__title { font-size: .72rem; letter-spacing: .14em; text-transform: uppercase; color: #6f7489; font-weight: 600; margin: 4px 10px 10px; }
  .mega__item { display: flex; gap: 14px; align-items: center; padding: 10px; border-radius: 14px; transition: background .2s; }
  .mega__item:hover { background: rgba(255,255,255,.06); }
  .mega__item strong { display: block; font-size: .95rem; font-weight: 600; color: #fff; }
  .mega__item small { color: #8a8fa3; font-size: .82rem; }
  .mega__icon { width: 40px; height: 40px; flex-shrink: 0; display: grid; place-items: center; border-radius: 12px; background: rgba(59,130,246,.14); color: var(--sky); }
  .mega__link { display: flex; gap: 10px; align-items: center; padding: 10px; border-radius: 12px; font-size: .92rem; color: #c9cddb; transition: background .2s, color .2s; }
  .mega__link:hover { background: rgba(255,255,255,.06); color: #fff; }
  .mega__link :global(svg) { color: var(--sky); }
  .mega__promo { position: relative; margin-top: 10px; padding: 16px; border-radius: 14px; background: linear-gradient(135deg, #2563eb, #7c3aed); display: grid; gap: 2px; overflow: hidden; }
  .mega__promo-tag { justify-self: start; font-size: .68rem; font-weight: 700; text-transform: uppercase; letter-spacing: .1em; background: var(--lime); color: var(--ink); padding: 2px 8px; border-radius: 999px; margin-bottom: 6px; }
  .mega__promo strong { font-family: var(--font-display); font-size: 1.15rem; letter-spacing: -.02em; }
  .mega__promo small { color: rgba(255,255,255,.8); font-size: .82rem; }
  .mega__promo :global(.mega__promo-arrow) { position: absolute; right: 14px; top: 14px; transition: transform .3s; }
  .mega__promo:hover :global(.mega__promo-arrow) { transform: translate(3px,-3px); }

  .hdr__cta { display: flex; align-items: center; gap: 10px; }
  .hdr__burger { display: none; width: 44px; height: 44px; border-radius: 50%; border: 0; background: rgba(255,255,255,.1); position: relative; }
  .hdr__burger span { position: absolute; left: 13px; right: 13px; height: 2px; background: #fff; border-radius: 2px; transition: transform .35s var(--ease), top .35s var(--ease); }
  .hdr__burger span:first-child { top: 18px; } .hdr__burger span:last-child { top: 25px; }
  .hdr.is-open .hdr__burger span:first-child { top: 21px; transform: rotate(45deg); }
  .hdr.is-open .hdr__burger span:last-child { top: 21px; transform: rotate(-45deg); }

  .mob { position: fixed; inset: 84px 12px auto; max-height: calc(100dvh - 100px); overflow: auto; padding: 24px; border-radius: 24px; background: rgba(10, 11, 18, .97); border: 1px solid rgba(255,255,255,.1); color: #fff; display: grid; gap: 24px; animation: drop .4s var(--ease); }
  .mob[hidden] { display: none; }
  @keyframes drop { from { opacity: 0; transform: translateY(-10px); } }
  .mob nav { display: grid; }
  .mob nav a { font-family: var(--font-display); font-size: 2rem; font-weight: 700; letter-spacing: -.04em; padding: 6px 0; border-bottom: 1px solid rgba(255,255,255,.06); }
  .mob__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .mob__grid a { display: block; padding: 6px 0; color: #b9bdcc; font-size: .92rem; }
  .mob__grid .mega__title { margin: 0 0 6px; }

  @media (max-width: 960px) {
    .hdr__nav { display: none; }
    .hdr__burger { display: block; }
  }
  @media (max-width: 480px) {
    .hdr__cta .btn { display: none; }
    .mob__grid { grid-template-columns: 1fr; }
  }
</style>
