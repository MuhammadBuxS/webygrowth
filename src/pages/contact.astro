---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Faq from '../components/Faq.astro';
import { SITE, HOME_FAQS, mailLink } from '../data/site';
import { SERVICES, INDUSTRIES } from '../data/pages';

const options = [...SERVICES, ...INDUSTRIES].map((p) => p.label).concat(['Free Website Audit', 'Something else']);
---
<BaseLayout
  title="Contact WebyGrowth | Free Website Audit & Consultation"
  description="Start your project with WebyGrowth. Request a free website audit or consultation for WordPress, WooCommerce, Shopify or SEO — for UK small businesses."
  crumbs={[{ name: 'Contact', path: '/contact/' }]}
>
  <section class="chero dark noise">
    <div class="grid-bg"></div>
    <div class="glow" style="width:700px;height:700px;background:#2563eb;left:-260px;top:-300px;opacity:.4"></div>
    <div class="glow" style="width:500px;height:500px;background:#8b5cf6;right:-200px;bottom:-100px;opacity:.25"></div>

    <div class="container chero__grid">
      <div class="chero__copy">
        <p class="eyebrow rise">Contact</p>
        <h1 class="display-lg rise" style="--d:.05s">Let's build your <span class="grad-text">growth engine.</span></h1>
        <p class="lead rise" style="--d:.1s">Tell us about your business and goals. We'll come back within one working day with honest advice and next steps — no hard sell.</p>

        <a class="cwa rise" style="--d:.12s" href={mailLink('Website enquiry')}>
          <span class="cwa__ico"><Icon name="mail" size={28} /></span>
          <span class="cwa__txt"><small>Prefer email?</small><strong>Email us directly</strong><em>{SITE.email}</em></span>
          <span class="cwa__go"><Icon name="arrow-up-right" size={20} /></span>
        </a>

        <ul class="cinfo rise" style="--d:.14s">
          <li>
            <span class="cinfo__ico"><Icon name="mail" size={20} /></span>
            <div><small>Email us</small><a href={`mailto:${SITE.email}`}>{SITE.email}</a></div>
          </li>
          <li>
            <span class="cinfo__ico"><Icon name="pin" size={20} /></span>
            <div><small>Location</small><span>{SITE.area}</span></div>
          </li>
          <li>
            <span class="cinfo__ico"><Icon name="clock" size={20} /></span>
            <div><small>Response time</small><span>Within one working day</span></div>
          </li>
        </ul>

        <div class="cnext rise" style="--d:.18s">
          <p class="cnext__t">What happens next?</p>
          <ol>
            <li><b>1</b> We review your enquiry &amp; current site</li>
            <li><b>2</b> Free consultation call to discuss goals</li>
            <li><b>3</b> Clear proposal with a fixed quote</li>
          </ol>
        </div>
      </div>

      <form class="cform rise" style="--d:.1s" data-form data-endpoint={SITE.formEndpoint ?? ''} data-email={SITE.email}>
        <div class="cform__head">
          <h2>Start your project</h2>
          <p class="muted">Fields marked * are required.</p>
        </div>
        <div class="cform__grid">
          <div class="field"><label for="name">Full name *</label><input id="name" name="name" required autocomplete="name" placeholder="Jane Smith" /></div>
          <div class="field"><label for="business">Business name</label><input id="business" name="business" autocomplete="organization" placeholder="Smith Roofing Ltd" /></div>
          <div class="field"><label for="email">Email address *</label><input id="email" name="email" type="email" required autocomplete="email" placeholder="jane@business.co.uk" /></div>
          <div class="field"><label for="phone">Phone number</label><input id="phone" name="phone" type="tel" autocomplete="tel" placeholder="07123 456789" /></div>
          <div class="field"><label for="website">Website URL</label><input id="website" name="website" type="url" placeholder="https://" /></div>
          <div class="field">
            <label for="service">Service needed *</label>
            <select id="service" name="service" required>
              <option value="" disabled selected>Select a service</option>
              {options.map((o) => <option>{o}</option>)}
            </select>
          </div>
          <div class="field field--full"><label for="details">Project details *</label><textarea id="details" name="details" required placeholder="Tell us about your business, goals and timeline…"></textarea></div>
        </div>
        <input type="text" name="_honey" tabindex="-1" autocomplete="off" class="sr-only" aria-hidden="true" />
        <button class="btn btn-primary cform__btn" type="submit">Send enquiry <span class="arrow"><Icon name="arrow" size={16} /></span></button>
        <p class="cform__note"><Icon name="lock" size={14} /> Your details are safe with us. We never share your information.</p>
        <p class="cform__status" role="status" aria-live="polite" data-status></p>
      </form>
    </div>
  </section>

  <Faq faqs={HOME_FAQS} />
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-form]')!;
  const status = form.querySelector<HTMLElement>('[data-status]')!;
  const btn = form.querySelector<HTMLButtonElement>('button[type=submit]')!;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = Object.fromEntries(new FormData(form).entries()) as Record<string, string>;
    if (data._honey) return;
    const endpoint = form.dataset.endpoint!;

    btn.disabled = true;
    status.classList.remove('ok');
    status.textContent = 'Sending…';
    try {
      const res = await fetch(endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({
          ...data,
          _subject: `New website enquiry: ${data.service || 'General'} (${data.name})`,
          _template: 'table',
          _captcha: 'false',
        }),
      });
      const json = await res.json().catch(() => ({}));
      if (!res.ok || String(json.success) !== 'true') throw new Error(json.message || `HTTP ${res.status}`);
      form.reset();
      status.textContent = 'Thank you! Your enquiry has been sent — we will be in touch within one working day.';
      status.classList.add('ok');
    } catch (err) {
      console.error('Contact form error:', err);
      const detail = err instanceof Error && err.message && !err.message.startsWith('Failed to fetch') ? ` (${err.message})` : '';
      status.textContent = `Sorry, your enquiry could not be sent${detail}. Please email us at ${form.dataset.email}.`;
    } finally {
      btn.disabled = false;
    }
  });
</script>

<style>
  .chero { position: relative; overflow: hidden; padding-top: clamp(130px, 15vw, 180px); padding-bottom: clamp(80px, 10vw, 130px); }
  .chero__grid { position: relative; display: grid; grid-template-columns: 1fr 1.1fr; gap: clamp(40px, 6vw, 90px); align-items: start; }
  .chero__copy { display: grid; gap: 26px; }
  .cwa { display: flex; align-items: center; gap: 16px; padding: 18px 20px; border-radius: 20px; background: linear-gradient(135deg, rgba(37,99,235,.28), rgba(139,92,246,.1)); border: 1px solid rgba(124,196,255,.35); transition: transform .4s var(--ease), border-color .3s, box-shadow .4s var(--ease); }
  .cwa:hover { transform: translateY(-3px); border-color: var(--sky); box-shadow: 0 24px 50px -24px rgba(37,99,235,.6); }
  .cwa__ico { width: 56px; height: 56px; flex-shrink: 0; border-radius: 16px; display: grid; place-items: center; background: var(--blue); color: #fff; }
  .cwa__txt { display: grid; flex: 1; }
  .cwa__txt small { color: var(--sky); font-size: .78rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; }
  .cwa__txt strong { font-family: var(--font-display); font-size: 1.35rem; line-height: 1.15; letter-spacing: -.02em; margin-block: 2px; }
  .cwa__txt em { font-style: normal; color: #c3c7d6; font-size: .95rem; }
  .cwa__go { width: 42px; height: 42px; flex-shrink: 0; border-radius: 50%; display: grid; place-items: center; background: rgba(255,255,255,.08); }
  .cinfo { list-style: none; margin: 10px 0 0; padding: 0; display: grid; gap: 12px; }
  .cinfo li { display: flex; gap: 16px; align-items: center; }
  .cinfo__ico { width: 50px; height: 50px; border-radius: 15px; display: grid; place-items: center; background: rgba(255,255,255,.06); border: 1px solid var(--line-dark); color: var(--sky); flex-shrink: 0; }
  .cinfo small { display: block; color: #7d8298; font-size: .8rem; }
  .cinfo a, .cinfo span { font-weight: 600; font-size: 1.05rem; }
  .cinfo a:hover { color: var(--sky); }
  .cnext { padding: 26px; border-radius: var(--radius); background: rgba(255,255,255,.03); border: 1px solid var(--line-dark); }
  .cnext__t { font-family: var(--font-display); font-weight: 600; font-size: 1.2rem; margin-bottom: 14px; }
  .cnext ol { list-style: none; padding: 0; margin: 0; display: grid; gap: 12px; color: #c3c7d6; }
  .cnext li { display: flex; gap: 12px; align-items: center; }
  .cnext b { width: 26px; height: 26px; border-radius: 50%; display: grid; place-items: center; background: var(--blue); font-size: .8rem; color: #fff; flex-shrink: 0; }

  .cform { padding: clamp(24px, 4vw, 44px); border-radius: 28px; background: linear-gradient(180deg, rgba(255,255,255,.07), rgba(255,255,255,.02)); border: 1px solid rgba(255,255,255,.12); backdrop-filter: blur(20px); box-shadow: 0 50px 100px -40px rgba(0,0,0,.7); display: grid; gap: 24px; }
  .cform__head h2 { font-size: 2rem; margin-bottom: 6px; }
  .cform__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
  .field--full { grid-column: 1 / -1; }
  .cform__btn { width: 100%; height: 58px; font-size: 1.05rem; }
  .cform__btn:disabled { opacity: .6; cursor: wait; }
  .cform__note { display: flex; gap: 8px; align-items: center; justify-content: center; color: #7d8298; font-size: .85rem; }
  .cform__status { text-align: center; font-weight: 500; color: #c3c7d6; }
  .cform__status:empty { display: none; }
  .cform__status:global(.ok) { color: var(--lime); }
  @media (max-width: 900px) { .chero__grid { grid-template-columns: 1fr; } }
  @media (max-width: 560px) { .cform__grid { grid-template-columns: 1fr; } }
</style>
