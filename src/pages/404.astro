---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---
<BaseLayout title="Page not found | WebyGrowth" description="The page you are looking for could not be found." noindex>
  <section class="nf dark noise">
    <div class="grid-bg"></div>
    <div class="glow" style="width:640px;height:640px;background:#2563eb;left:50%;top:-240px;transform:translateX(-50%);opacity:.4"></div>
    <div class="container nf__inner">
      <p class="nf__code grad-text">404</p>
      <h1 class="display-md">This page took a wrong turn.</h1>
      <p class="lead">The page you're looking for doesn't exist or has moved. Let's get you back on track.</p>
      <div class="nf__btns">
        <a class="btn btn-primary" href="/">Back to home <span class="arrow"><Icon name="arrow" size={16} /></span></a>
        <a class="btn btn-ghost" href="/services/">View services</a>
      </div>
    </div>
  </section>
</BaseLayout>
<style>
  .nf { position: relative; overflow: hidden; min-height: 90vh; display: grid; align-items: center; padding-block: 160px 100px; }
  .nf__inner { position: relative; display: grid; gap: 22px; justify-items: center; text-align: center; }
  .nf__code { font-family: var(--font-display); font-weight: 800; font-size: clamp(7rem, 22vw, 16rem); line-height: .8; letter-spacing: -.07em; }
  .nf__btns { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; }
</style>
